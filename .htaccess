# ---------------------------------------------------------------------------
# Gaurav Electromech - Apache configuration
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.php index.html

# ---- Canonical host: force https://www.earthingmanufacturers.com ----------
# Scoped to the live domain only, so local XAMPP (localhost/earthabhinaav)
# is never redirected away.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # http -> https (live host only)
    RewriteCond %{HTTP_HOST} earthingmanufacturers\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://www.earthingmanufacturers.com%{REQUEST_URI} [R=301,L]

    # non-www -> www (live host only)
    RewriteCond %{HTTP_HOST} ^earthingmanufacturers\.com$ [NC]
    RewriteRule ^ https://www.earthingmanufacturers.com%{REQUEST_URI} [R=301,L]

    # /path/index.php -> /path/  (matches the canonical tag emitted by seo-meta.php)
    RewriteCond %{HTTP_HOST} earthingmanufacturers\.com$ [NC]
    RewriteCond %{THE_REQUEST} \s/(.*/)?index\.php[\s?] [NC]
    RewriteRule ^(.*/)?index\.php$ /%1 [R=301,L]
</IfModule>

# ---- Custom error page ----------------------------------------------------
ErrorDocument 404 /404.php

# ---- Compression ----------------------------------------------------------
# text/javascript is the type this server actually sends for .js files, and it
# has to be listed explicitly - without it the CSS was compressed and the JS
# was not, which is exactly what the technical audit flagged.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ---- Browser caching ------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType video/mp4                 "access plus 1 year"

    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType font/woff2                "access plus 1 year"

    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    Header set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Clickjacking: refuse to be rendered inside a frame on another origin.
    # SAMEORIGIN rather than DENY - the audit accepts either, and this still
    # allows the site to frame its own pages if that is ever wanted.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Content-Security-Policy. The allowed hosts below are not guesswork - they
    # are every origin the pages actually request at runtime:
    #   googletagmanager.com  GA4 tag          google-analytics.com  GA4 beacons
    #   fonts.googleapis.com  font stylesheet  fonts.gstatic.com     font files
    #   cdnjs.cloudflare.com  Font Awesome css + its webfonts
    #   images.pexels.com     "Professional Team" photo on city pages
    #   images.unsplash.com   background-image in styles.css (line ~855)
    #
    # 'unsafe-inline' is required and cannot currently be dropped:
    #   style-src   1020 inline style="" attributes plus 25 inline <style> blocks
    #   script-src  the JSON-LD block in seo-meta.php differs on every page, so
    #               it cannot be covered by a static hash, and a nonce would need
    #               the header emitted from PHP rather than here. The policy
    #               still blocks scripts from any host not listed above.
    # Keep this on ONE line - a broken line continuation here is a 500 on every page.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.pexels.com https://images.unsplash.com https://*.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com https://*.googletagmanager.com https://analytics.google.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    # HTTP Strict Transport Security. Deliberately short to start with: HSTS is
    # one-way - once a browser has seen it, that visitor cannot reach the site
    # over http until the max-age runs out, so a lapsed certificate would take
    # them offline with no server-side way to undo it. 300s means any mistake
    # expires in five minutes. Raise to 31536000 (plus includeSubDomains) only
    # after this has run clean on the live host for a week or two.
    # No 'preload' - that lands in Chrome's hardcoded list and takes months to leave.
    # The http -> https 301 is at the top of this file; browsers ignore an HSTS
    # header served over http, so local XAMPP is unaffected either way.
    Header always set Strict-Transport-Security "max-age=300"
</IfModule>

# ---- Keep source and archive files out of the public site -----------------
<FilesMatch "\.(zip|tar|gz|bak|sql|log)$">
    Require all denied
</FilesMatch>
